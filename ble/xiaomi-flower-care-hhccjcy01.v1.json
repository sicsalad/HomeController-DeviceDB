{
  "$schema": "../schemas/ble-profile-v1.schema.json",
  "schemaVersion": 1,
  "id": "xiaomi-flower-care-hhccjcy01",
  "version": 1,
  "minimumRuntimeVersion": 1,
  "status": "experimental",
  "protocol": "Xiaomi Flower Care BLE GATT",
  "match": {
    "namePatterns": ["^Flower care$", "^Flower Care$"],
    "serviceUuids": ["00001204-0000-1000-8000-00805f9b34fb", "0000FE95-0000-1000-8000-00805F9B34FB"],
    "manufacturerIds": [],
    "serviceDataUuids": ["FE95"]
  },
  "source": {
    "name": "WatchFlower Flower Care BLE API",
    "url": "https://github.com/emericg/WatchFlower/blob/master/docs/flowercare-ble-api.md",
    "license": "MIT",
    "notes": "HHCCJCY01 real-time values require the safe mode-change write A01F before reading characteristic 1A01."
  },
  "fields": [
    {"code":"temperature","name":"Temperature","unit":"°C","input":{"kind":"characteristic","serviceUuid":"00001204-0000-1000-8000-00805f9b34fb","characteristicUuid":"00001a01-0000-1000-8000-00805f9b34fb"},"decode":{"type":"int16le","offset":0,"length":2,"scale":0.1}},
    {"code":"illuminance","name":"Illuminance","unit":"lux","input":{"kind":"characteristic","serviceUuid":"00001204-0000-1000-8000-00805f9b34fb","characteristicUuid":"00001a01-0000-1000-8000-00805f9b34fb"},"decode":{"type":"uint32le","offset":3,"length":4}},
    {"code":"moisture","name":"Soil moisture","unit":"%","input":{"kind":"characteristic","serviceUuid":"00001204-0000-1000-8000-00805f9b34fb","characteristicUuid":"00001a01-0000-1000-8000-00805f9b34fb"},"decode":{"type":"uint8","offset":7,"length":1}},
    {"code":"conductivity","name":"Soil conductivity","unit":"µS/cm","input":{"kind":"characteristic","serviceUuid":"00001204-0000-1000-8000-00805f9b34fb","characteristicUuid":"00001a01-0000-1000-8000-00805f9b34fb"},"decode":{"type":"uint16le","offset":8,"length":2}},
    {"code":"battery","name":"Battery","unit":"%","input":{"kind":"characteristic","serviceUuid":"00001204-0000-1000-8000-00805f9b34fb","characteristicUuid":"00001a02-0000-1000-8000-00805f9b34fb"},"decode":{"type":"uint8","offset":0,"length":1}},
    {"code":"firmware","name":"Firmware version","input":{"kind":"characteristic","serviceUuid":"00001204-0000-1000-8000-00805f9b34fb","characteristicUuid":"00001a02-0000-1000-8000-00805f9b34fb"},"decode":{"type":"ascii","offset":2,"length":5}}
  ],
  "operations": [
    {"id":"enable-realtime-data","kind":"write","serviceUuid":"00001204-0000-1000-8000-00805f9b34fb","characteristicUuid":"00001a00-0000-1000-8000-00805f9b34fb","valueHex":"A01F","safe":true},
    {"id":"read-realtime-data","kind":"read","serviceUuid":"00001204-0000-1000-8000-00805f9b34fb","characteristicUuid":"00001a01-0000-1000-8000-00805f9b34fb","safe":true},
    {"id":"read-device-info","kind":"read","serviceUuid":"00001204-0000-1000-8000-00805f9b34fb","characteristicUuid":"00001a02-0000-1000-8000-00805f9b34fb","safe":true}
  ]
}
