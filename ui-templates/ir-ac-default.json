{
  "$schema": "../schemas/device-ui-template-v2.schema.json",
  "schemaVersion": 2,
  "id": "ir-ac-default",
  "name": "Modern Climate Remote",
  "deviceTypeId": "air-conditioner",
  "connections": ["infrared"],
  "renderer": "declarative",
  "access": "free",
  "columns": 4,
  "useFullWidth": true,
  "horizontalSpacing": 8,
  "verticalSpacing": 10,
  "screenMarginLeft": 12,
  "screenMarginTop": 12,
  "screenMarginRight": 12,
  "screenMarginBottom": 18,
  "backgroundMode": "vertical-gradient",
  "backgroundColor": "#07161C",
  "backgroundColor2": "#0B2630",
  "foregroundColor": "#F3FCFF",
  "mutedTextColor": "#91B6C0",
  "surfaceColor": "#102B35",
  "accentColor": "#45D7C5",
  "buttonColor": "#163945",
  "buttonTextColor": "#F4FCFF",
  "borderColor": "#285865",
  "buttonCornerRadius": 16,
  "sectionCornerRadius": 22,
  "buttonHeight": 56,
  "buttonFontSize": 13,
  "iconFontSize": 24,
  "groups": [
    {
      "id": "climate-header",
      "name": "Climate",
      "titlePlacement": "hidden",
      "order": 10,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 24,
      "borderColor": "#2C6370",
      "borderWidth": 1,
      "backgroundMode": "vertical-gradient",
      "backgroundColor": "#0E303A",
      "backgroundColor2": "#0A2029",
      "controls": [
        { "id": "title", "order": 10, "type": "label", "label": "CLIMATE", "row": 0, "column": 0, "columnSpan": 3, "fontSize": 20, "fontAttribute": "bold", "textColor": "#E9FBFF" },
        { "id": "power", "order": 20, "type": "button", "label": "POWER", "command": "Power", "row": 0, "column": 3, "height": 60, "fontSize": 13, "fontAttribute": "bold", "shape": "rounded", "backgroundColor": "#D94A59", "textColor": "#FFFFFF", "borderColor": "#FF7884", "borderWidth": 1 },
        { "id": "status", "order": 30, "type": "label", "label": "Temperature • Mode • Fan", "row": 1, "column": 0, "columnSpan": 4, "fontSize": 12, "textColor": "#91B6C0" }
      ]
    },
    {
      "id": "temperature",
      "name": "Temperature",
      "titlePlacement": "border",
      "order": 20,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 22,
      "borderColor": "#2A5B68",
      "borderWidth": 1,
      "backgroundMode": "solid",
      "backgroundColor": "#0D2933",
      "controls": [
        { "id": "temp-down", "order": 10, "type": "button", "label": "−", "command": "TemperatureDown", "row": 0, "column": 0, "columnSpan": 1, "height": 68, "fontSize": 30, "backgroundColor": "#17638B", "textColor": "#F1FBFF", "borderWidth": 0 },
        { "id": "temp-label", "order": 20, "type": "label", "label": "TEMP", "row": 0, "column": 1, "columnSpan": 2, "fontSize": 18, "fontAttribute": "bold", "textColor": "#45D7C5" },
        { "id": "temp-up", "order": 30, "type": "button", "label": "+", "command": "TemperatureUp", "row": 0, "column": 3, "columnSpan": 1, "height": 68, "fontSize": 30, "backgroundColor": "#9B5727", "textColor": "#FFF7ED", "borderWidth": 0 }
      ]
    },
    {
      "id": "mode",
      "name": "Mode",
      "titlePlacement": "border",
      "order": 30,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 20,
      "borderColor": "#285865",
      "borderWidth": 1,
      "backgroundMode": "solid",
      "backgroundColor": "#0C252E",
      "controls": [
        { "id": "mode-auto", "order": 10, "type": "button", "label": "AUTO", "command": "ModeAuto", "stateKey": "mode", "setState": "auto", "row": 0, "column": 0, "backgroundColor": "#455A64", "textColor": "#F4FAFC" },
        { "id": "mode-cool", "order": 20, "type": "button", "label": "COOL", "command": "ModeCool", "stateKey": "mode", "setState": "cool", "row": 0, "column": 1, "backgroundColor": "#1976A8", "textColor": "#F0FBFF" },
        { "id": "mode-heat", "order": 30, "type": "button", "label": "HEAT", "command": "ModeHeat", "stateKey": "mode", "setState": "heat", "row": 0, "column": 2, "backgroundColor": "#B25A2B", "textColor": "#FFF5E8" },
        { "id": "mode-dry", "order": 40, "type": "button", "label": "DRY", "command": "ModeDry", "stateKey": "mode", "setState": "dry", "row": 0, "column": 3, "backgroundColor": "#50679A", "textColor": "#F6F8FF" },
        { "id": "mode-fan", "order": 50, "type": "button", "label": "FAN", "command": "ModeFan", "stateKey": "mode", "setState": "fan", "row": 1, "column": 1, "columnSpan": 2, "backgroundColor": "#24706A", "textColor": "#F0FFFD" }
      ]
    },
    {
      "id": "airflow",
      "name": "Airflow",
      "titlePlacement": "border",
      "order": 40,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 20,
      "borderColor": "#285865",
      "borderWidth": 1,
      "backgroundMode": "solid",
      "backgroundColor": "#0C252E",
      "controls": [
        { "id": "fan-down", "order": 10, "type": "button", "label": "FAN −", "command": "FanSpeedDown", "row": 0, "column": 0, "backgroundColor": "#1C4C58" },
        { "id": "fan-auto", "order": 20, "type": "button", "label": "AUTO", "command": "FanSpeedAuto", "row": 0, "column": 1, "columnSpan": 2, "backgroundColor": "#27666A", "textColor": "#EBFFFF" },
        { "id": "fan-up", "order": 30, "type": "button", "label": "FAN +", "command": "FanSpeedUp", "row": 0, "column": 3, "backgroundColor": "#1C4C58" },
        { "id": "swing", "order": 40, "type": "button", "label": "SWING", "command": "Swing", "stateKey": "swing", "cycleStates": ["off", "on"], "row": 1, "column": 0, "columnSpan": 4, "backgroundColor": "#2B746C", "textColor": "#F0FFFC", "fontAttribute": "bold" }
      ]
    },
    {
      "id": "comfort",
      "name": "Comfort",
      "titlePlacement": "border",
      "order": 50,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 20,
      "borderColor": "#285865",
      "borderWidth": 1,
      "backgroundMode": "solid",
      "backgroundColor": "#0B222B",
      "controls": [
        { "id": "sleep", "order": 10, "type": "button", "label": "SLEEP", "command": "Sleep", "row": 0, "column": 0, "columnSpan": 2, "backgroundColor": "#4A4E86", "textColor": "#F7F5FF" },
        { "id": "turbo", "order": 20, "type": "button", "label": "TURBO", "command": "Turbo", "row": 0, "column": 2, "columnSpan": 2, "backgroundColor": "#A8453E", "textColor": "#FFFFFF" },
        { "id": "economy", "order": 30, "type": "button", "label": "ECO", "command": "Economy", "row": 1, "column": 0, "columnSpan": 2, "backgroundColor": "#2E704D", "textColor": "#EEFFF5" },
        { "id": "timer", "order": 40, "type": "button", "label": "TIMER", "command": "Timer", "row": 1, "column": 2, "columnSpan": 2, "backgroundColor": "#66558C", "textColor": "#FAF7FF" }
      ]
    }
  ],
  "initialStates": {
    "mode": "auto",
    "swing": "off"
  },
  "integrationChildPresentations": {}
}
