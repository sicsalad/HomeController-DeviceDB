{
  "$schema": "../schemas/device-ui-template-v1.schema.json",
  "schemaVersion": 1,
  "id": "wifi-tv-default",
  "name": "TV Wi-Fi par défaut",
  "deviceTypeId": "television",
  "connections": [
    "wifi"
  ],
  "renderer": "declarative",
  "columns": 3,
  "useFullWidth": true,
  "sections": [
    {
      "title": "Alimentation / Volume",
      "controls": [
        {
          "type": "button",
          "label": "Alimentation",
          "command": "power",
          "icon": "⏻"
        },
        {
          "type": "button",
          "label": "VOL +",
          "command": "volumeUp"
        },
        {
          "type": "button",
          "label": "VOL −",
          "command": "volumeDown"
        },
        {
          "type": "button",
          "label": "Muet",
          "command": "mute"
        }
      ]
    },
    {
      "title": "Navigation",
      "controls": [
        {
          "type": "button",
          "label": "Haut",
          "command": "up",
          "icon": "▲",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "Gauche",
          "command": "left",
          "icon": "◀",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "OK",
          "command": "ok"
        },
        {
          "type": "button",
          "label": "Droite",
          "command": "right",
          "icon": "▶",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "Bas",
          "command": "down",
          "icon": "▼",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "Retour",
          "command": "back"
        },
        {
          "type": "button",
          "label": "Accueil",
          "command": "home"
        },
        {
          "type": "button",
          "label": "Source",
          "command": "source"
        }
      ]
    }
  ]
}
