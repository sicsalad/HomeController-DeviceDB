{
  "$schema": "../schemas/device-ui-template-v1.schema.json",
  "schemaVersion": 1,
  "id": "ir-ac-modern",
  "name": "Moderne Klimaanlage",
  "deviceTypeId": "air-conditioner",
  "connections": [
    "infrared"
  ],
  "renderer": "declarative",
  "columns": 4,
  "useFullWidth": true,
  "buttonCornerRadius": 10,
  "sectionCornerRadius": 16,
  "buttonHeight": 58,
  "buttonFontSize": 11,
  "iconFontSize": 24,
  "sections": [
    {
      "subtitle": "Klimasteuerung",
      "controls": [
        {
          "type": "tile",
          "label": "EIN/AUS",
          "command": "Power",
          "icon": "⏻",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "MODUS",
          "command": "Mode",
          "icon": "◫"
        },
        {
          "type": "tile",
          "label": "LÜFTER",
          "command": "FanSpeed",
          "icon": "✣"
        }
      ]
    },
    {
      "title": "TEMPERATUR",
      "controls": [
        {
          "type": "tile",
          "label": "KÄLTER",
          "command": "TemperatureDown",
          "icon": "−",
          "columnSpan": 2,
          "height": 70,
          "iconSize": 31
        },
        {
          "type": "tile",
          "label": "WÄRMER",
          "command": "TemperatureUp",
          "icon": "＋",
          "columnSpan": 2,
          "height": 70,
          "iconSize": 31
        }
      ]
    },
    {
      "title": "MODUS",
      "controls": [
        {
          "type": "tile",
          "label": "AUTO",
          "command": "ModeAuto",
          "icon": "A"
        },
        {
          "type": "tile",
          "label": "KÜHLEN",
          "command": "ModeCool",
          "icon": "❄"
        },
        {
          "type": "tile",
          "label": "HEIZEN",
          "command": "ModeHeat",
          "icon": "☀"
        },
        {
          "type": "tile",
          "label": "TROCKNEN",
          "command": "ModeDry",
          "icon": "◌"
        },
        {
          "type": "tile",
          "label": "LÜFTER",
          "command": "ModeFan",
          "icon": "✣",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "LÜFTER AUTO",
          "command": "FanSpeedAuto",
          "icon": "◎",
          "columnSpan": 2
        }
      ]
    },
    {
      "title": "LUFTSTROM",
      "controls": [
        {
          "type": "tile",
          "label": "FAN −",
          "command": "FanSpeedDown",
          "icon": "−"
        },
        {
          "type": "tile",
          "label": "FAN +",
          "command": "FanSpeedUp",
          "icon": "＋"
        },
        {
          "type": "tile",
          "label": "SCHWENKEN",
          "command": "Swing",
          "icon": "↕",
          "columnSpan": 2
        }
      ]
    },
    {
      "title": "KOMFORT & ENERGIE",
      "controls": [
        {
          "type": "tile",
          "label": "TURBO",
          "command": "Turbo",
          "icon": "⚡"
        },
        {
          "type": "tile",
          "label": "LEISE",
          "command": "Quiet",
          "icon": "◔"
        },
        {
          "type": "tile",
          "label": "ECO",
          "command": "Economy",
          "icon": "♧"
        },
        {
          "type": "tile",
          "label": "SCHLAF",
          "command": "Sleep",
          "icon": "☾"
        },
        {
          "type": "tile",
          "label": "ENERGIESPAREN",
          "command": "PowerSave",
          "icon": "◒",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "LICHT",
          "command": "Light",
          "icon": "☼",
          "columnSpan": 2
        }
      ]
    },
    {
      "title": "MEHR",
      "controls": [
        {
          "type": "tile",
          "label": "SELBSTREINIGUNG",
          "command": "SelfClean",
          "icon": "✦",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "X-FAN",
          "command": "XFanCleaning",
          "icon": "≈",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "I FEEL",
          "command": "IFeel",
          "icon": "⌖",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "TIMER",
          "command": "Timer",
          "icon": "◷",
          "columnSpan": 2
        }
      ]
    }
  ]
}
