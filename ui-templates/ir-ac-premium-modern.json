{
  "$schema": "../schemas/device-ui-template-v2.schema.json",
  "schemaVersion": 2,
  "id": "ir-ac-premium-modern",
  "name": "Modern Climate Remote Pro",
  "deviceTypeId": "air-conditioner",
  "connections": ["infrared"],
  "renderer": "declarative",
  "access": "premium",
  "columns": 4,
  "useFullWidth": true,
  "horizontalSpacing": 8,
  "verticalSpacing": 10,
  "screenMarginLeft": 12,
  "screenMarginTop": 12,
  "screenMarginRight": 12,
  "screenMarginBottom": 18,
  "backgroundMode": "vertical-gradient",
  "backgroundColor": "#051219",
  "backgroundColor2": "#092832",
  "foregroundColor": "#F4FCFF",
  "mutedTextColor": "#8EB8C4",
  "surfaceColor": "#0F2C36",
  "accentColor": "#3FE0CC",
  "buttonColor": "#153B47",
  "buttonTextColor": "#F5FDFF",
  "borderColor": "#2A6270",
  "buttonCornerRadius": 18,
  "sectionCornerRadius": 24,
  "buttonHeight": 58,
  "buttonFontSize": 13,
  "iconFontSize": 25,
  "groups": [
    {
      "id": "hero",
      "name": "Climate",
      "titlePlacement": "hidden",
      "order": 10,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 26,
      "borderColor": "#327685",
      "borderWidth": 1,
      "backgroundMode": "vertical-gradient",
      "backgroundColor": "#10404A",
      "backgroundColor2": "#0A222B",
      "controls": [
        { "id": "hero-title", "order": 10, "type": "label", "label": "CLIMATE", "row": 0, "column": 0, "columnSpan": 3, "fontSize": 21, "fontAttribute": "bold", "textColor": "#EDFDFF" },
        { "id": "power", "order": 20, "type": "button", "label": "⏻", "command": "Power", "row": 0, "column": 3, "height": 62, "fontSize": 27, "shape": "rounded", "backgroundColor": "#EF4D67", "textColor": "#FFFFFF", "borderWidth": 0 },
        { "id": "hero-subtitle", "order": 30, "type": "label", "label": "Comfort control", "row": 1, "column": 0, "columnSpan": 4, "fontSize": 12, "textColor": "#8EB8C4" }
      ]
    },
    {
      "id": "temperature",
      "name": "Temperature",
      "titlePlacement": "border",
      "order": 20,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 24,
      "borderColor": "#2D6673",
      "borderWidth": 1,
      "backgroundMode": "vertical-gradient",
      "backgroundColor": "#0E3039",
      "backgroundColor2": "#0B272F",
      "controls": [
        { "id": "temp-down", "order": 10, "type": "button", "label": "−", "command": "TemperatureDown", "row": 0, "column": 0, "height": 72, "fontSize": 32, "backgroundColor": "#153C48", "textColor": "#E4FBFF", "borderWidth": 0 },
        { "id": "temp-center", "order": 20, "type": "label", "label": "SET TEMP", "row": 0, "column": 1, "columnSpan": 2, "fontSize": 17, "fontAttribute": "bold", "textColor": "#3FE0CC" },
        { "id": "temp-up", "order": 30, "type": "button", "label": "+", "command": "TemperatureUp", "row": 0, "column": 3, "height": 72, "fontSize": 32, "backgroundColor": "#153C48", "textColor": "#E4FBFF", "borderWidth": 0 }
      ]
    },
    {
      "id": "modes",
      "name": "Mode",
      "titlePlacement": "border",
      "order": 30,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 22,
      "borderColor": "#2B606D",
      "borderWidth": 1,
      "backgroundMode": "solid",
      "backgroundColor": "#0C252E",
      "controls": [
        { "id": "auto", "order": 10, "type": "button", "label": "AUTO", "command": "ModeAuto", "stateKey": "mode", "setState": "auto", "row": 0, "column": 0, "backgroundColor": "#1A4A56" },
        { "id": "cool", "order": 20, "type": "button", "label": "❄ COOL", "command": "ModeCool", "stateKey": "mode", "setState": "cool", "row": 0, "column": 1, "backgroundColor": "#176A96", "textColor": "#F1FBFF" },
        { "id": "heat", "order": 30, "type": "button", "label": "☀ HEAT", "command": "ModeHeat", "stateKey": "mode", "setState": "heat", "row": 0, "column": 2, "backgroundColor": "#94591E", "textColor": "#FFF6E7" },
        { "id": "dry", "order": 40, "type": "button", "label": "DRY", "command": "ModeDry", "stateKey": "mode", "setState": "dry", "row": 0, "column": 3, "backgroundColor": "#315871" },
        { "id": "fan-mode", "order": 50, "type": "button", "label": "FAN ONLY", "command": "ModeFan", "stateKey": "mode", "setState": "fan", "row": 1, "column": 1, "columnSpan": 2, "backgroundColor": "#245F5D", "textColor": "#F0FFFD" }
      ]
    },
    {
      "id": "fan-airflow",
      "name": "Fan & Airflow",
      "titlePlacement": "border",
      "order": 40,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 22,
      "borderColor": "#2B606D",
      "borderWidth": 1,
      "backgroundMode": "solid",
      "backgroundColor": "#0C252E",
      "controls": [
        { "id": "fan-down", "order": 10, "type": "button", "label": "− FAN", "command": "FanSpeedDown", "row": 0, "column": 0, "backgroundColor": "#173D49" },
        { "id": "fan-auto", "order": 20, "type": "button", "label": "AUTO FAN", "command": "FanSpeedAuto", "row": 0, "column": 1, "columnSpan": 2, "backgroundColor": "#1F5559" },
        { "id": "fan-up", "order": 30, "type": "button", "label": "FAN +", "command": "FanSpeedUp", "row": 0, "column": 3, "backgroundColor": "#173D49" },
        { "id": "swing", "order": 40, "type": "button", "label": "↕  SWING", "command": "Swing", "stateKey": "swing", "cycleStates": ["off", "on"], "row": 1, "column": 0, "columnSpan": 4, "backgroundColor": "#296C65", "textColor": "#F0FFFC", "fontAttribute": "bold" }
      ]
    },
    {
      "id": "quick-actions",
      "name": "Quick actions",
      "titlePlacement": "border",
      "order": 50,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 22,
      "borderColor": "#2B606D",
      "borderWidth": 1,
      "backgroundMode": "solid",
      "backgroundColor": "#0A222A",
      "controls": [
        { "id": "sleep", "order": 10, "type": "button", "label": "☾ SLEEP", "command": "Sleep", "row": 0, "column": 0, "columnSpan": 2, "backgroundColor": "#353C68" },
        { "id": "turbo", "order": 20, "type": "button", "label": "⚡ TURBO", "command": "Turbo", "row": 0, "column": 2, "columnSpan": 2, "backgroundColor": "#99423A", "textColor": "#FFFFFF" },
        { "id": "eco", "order": 30, "type": "button", "label": "ECO", "command": "Economy", "row": 1, "column": 0, "columnSpan": 2, "backgroundColor": "#28684A", "textColor": "#EFFFF6" },
        { "id": "timer", "order": 40, "type": "button", "label": "TIMER", "command": "Timer", "row": 1, "column": 2, "columnSpan": 2, "backgroundColor": "#514A78" }
      ]
    }
  ],
  "initialStates": {
    "mode": "auto",
    "swing": "off"
  },
  "integrationChildPresentations": {}
}
