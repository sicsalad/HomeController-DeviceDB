{
  "$schema": "../schemas/device-ui-template-v2.schema.json",
  "schemaVersion": 2,
  "id": "ir-ac-premium-modern",
  "name": "Modern Climate Remote",
  "deviceTypeId": "air-conditioner",
  "connections": ["infrared"],
  "renderer": "builtin-ir-ac",
  "access": "premium",
  "columns": 3,
  "useFullWidth": true,
  "horizontalSpacing": 10,
  "verticalSpacing": 12,
  "screenMarginLeft": 14,
  "screenMarginTop": 14,
  "screenMarginRight": 14,
  "screenMarginBottom": 20,
  "backgroundMode": "vertical-gradient",
  "backgroundColor": "#06151D",
  "backgroundColor2": "#0A2631",
  "foregroundColor": "#F3FBFD",
  "mutedTextColor": "#8FB6C2",
  "surfaceColor": "#102B36",
  "accentColor": "#37D4C5",
  "buttonColor": "#173B47",
  "buttonTextColor": "#F7FEFF",
  "borderColor": "#2C5B68",
  "buttonCornerRadius": 16,
  "sectionCornerRadius": 22,
  "buttonHeight": 58,
  "buttonFontSize": 14,
  "iconFontSize": 26,
  "itemDefaults": {
    "shape": "rounded",
    "cornerRadius": 16,
    "showIcon": true,
    "showName": true,
    "showType": false,
    "showState": true
  },
  "initialStates": {
    "power": "false",
    "temperature": "24",
    "mode": "cool",
    "fan": "auto",
    "swing": "false"
  },
  "integrationChildPresentations": {}
}
