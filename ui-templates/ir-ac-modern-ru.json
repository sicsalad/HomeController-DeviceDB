{
  "$schema": "../schemas/device-ui-template-v1.schema.json",
  "schemaVersion": 1,
  "id": "ir-ac-modern",
  "name": "Современный климат",
  "deviceTypeId": "air-conditioner",
  "connections": [
    "infrared"
  ],
  "renderer": "declarative",
  "columns": 4,
  "useFullWidth": true,
  "buttonCornerRadius": 10,
  "sectionCornerRadius": 16,
  "buttonHeight": 58,
  "buttonFontSize": 11,
  "iconFontSize": 24,
  "sections": [
    {
      "subtitle": "Управление климатом",
      "controls": [
        {
          "type": "tile",
          "label": "ПИТАНИЕ",
          "command": "Power",
          "icon": "⏻",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "РЕЖИМ",
          "command": "Mode",
          "icon": "◫"
        },
        {
          "type": "tile",
          "label": "ВЕНТИЛЯТОР",
          "command": "FanSpeed",
          "icon": "✣"
        }
      ]
    },
    {
      "title": "ТЕМПЕРАТУРА",
      "controls": [
        {
          "type": "tile",
          "label": "ХОЛОДНЕЕ",
          "command": "TemperatureDown",
          "icon": "−",
          "columnSpan": 2,
          "height": 70,
          "iconSize": 31
        },
        {
          "type": "tile",
          "label": "ТЕПЛЕЕ",
          "command": "TemperatureUp",
          "icon": "＋",
          "columnSpan": 2,
          "height": 70,
          "iconSize": 31
        }
      ]
    },
    {
      "title": "РЕЖИМ",
      "controls": [
        {
          "type": "tile",
          "label": "АВТО",
          "command": "ModeAuto",
          "icon": "A"
        },
        {
          "type": "tile",
          "label": "ОХЛАЖДЕНИЕ",
          "command": "ModeCool",
          "icon": "❄"
        },
        {
          "type": "tile",
          "label": "ОБОГРЕВ",
          "command": "ModeHeat",
          "icon": "☀"
        },
        {
          "type": "tile",
          "label": "ОСУШЕНИЕ",
          "command": "ModeDry",
          "icon": "◌"
        },
        {
          "type": "tile",
          "label": "ВЕНТИЛЯТОР",
          "command": "ModeFan",
          "icon": "✣",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "ВЕНТИЛЯТОР АВТО",
          "command": "FanSpeedAuto",
          "icon": "◎",
          "columnSpan": 2
        }
      ]
    },
    {
      "title": "ПОТОК ВОЗДУХА",
      "controls": [
        {
          "type": "tile",
          "label": "FAN −",
          "command": "FanSpeedDown",
          "icon": "−"
        },
        {
          "type": "tile",
          "label": "FAN +",
          "command": "FanSpeedUp",
          "icon": "＋"
        },
        {
          "type": "tile",
          "label": "КАЧАНИЕ",
          "command": "Swing",
          "icon": "↕",
          "columnSpan": 2
        }
      ]
    },
    {
      "title": "КОМФОРТ И ЭНЕРГИЯ",
      "controls": [
        {
          "type": "tile",
          "label": "ТУРБО",
          "command": "Turbo",
          "icon": "⚡"
        },
        {
          "type": "tile",
          "label": "ТИХО",
          "command": "Quiet",
          "icon": "◔"
        },
        {
          "type": "tile",
          "label": "ЭКО",
          "command": "Economy",
          "icon": "♧"
        },
        {
          "type": "tile",
          "label": "СОН",
          "command": "Sleep",
          "icon": "☾"
        },
        {
          "type": "tile",
          "label": "ЭНЕРГОСБЕРЕЖЕНИЕ",
          "command": "PowerSave",
          "icon": "◒",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "СВЕТ",
          "command": "Light",
          "icon": "☼",
          "columnSpan": 2
        }
      ]
    },
    {
      "title": "ЕЩЁ",
      "controls": [
        {
          "type": "tile",
          "label": "САМООЧИСТКА",
          "command": "SelfClean",
          "icon": "✦",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "X-FAN",
          "command": "XFanCleaning",
          "icon": "≈",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "I FEEL",
          "command": "IFeel",
          "icon": "⌖",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "ТАЙМЕР",
          "command": "Timer",
          "icon": "◷",
          "columnSpan": 2
        }
      ]
    }
  ]
}
