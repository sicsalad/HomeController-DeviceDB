{
  "$schema": "../schemas/device-ui-template-v1.schema.json",
  "schemaVersion": 1,
  "id": "wifi-tv-default",
  "name": "WLAN-TV Standard",
  "deviceTypeId": "television",
  "connections": [
    "wifi"
  ],
  "renderer": "declarative",
  "columns": 3,
  "useFullWidth": true,
  "sections": [
    {
      "title": "Ein/Aus / Lautstärke",
      "controls": [
        {
          "type": "button",
          "label": "EIN/AUS",
          "command": "power",
          "icon": "⏻"
        },
        {
          "type": "button",
          "label": "VOL +",
          "command": "volumeUp"
        },
        {
          "type": "button",
          "label": "VOL −",
          "command": "volumeDown"
        },
        {
          "type": "button",
          "label": "STUMM",
          "command": "mute"
        }
      ]
    },
    {
      "title": "Navigation",
      "controls": [
        {
          "type": "button",
          "label": "Hoch",
          "command": "up",
          "icon": "▲",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "Links",
          "command": "left",
          "icon": "◀",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "OK",
          "command": "ok"
        },
        {
          "type": "button",
          "label": "Rechts",
          "command": "right",
          "icon": "▶",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "Runter",
          "command": "down",
          "icon": "▼",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "Zurück",
          "command": "back"
        },
        {
          "type": "button",
          "label": "Start",
          "command": "home"
        },
        {
          "type": "button",
          "label": "QUELLE",
          "command": "source"
        }
      ]
    }
  ]
}
