{
  "$schema": "../schemas/device-ui-template-v1.schema.json",
  "schemaVersion": 1,
  "id": "wifi-tv-default",
  "name": "Wi-Fi ТВ по умолчанию",
  "deviceTypeId": "television",
  "connections": [
    "wifi"
  ],
  "renderer": "declarative",
  "columns": 3,
  "useFullWidth": true,
  "sections": [
    {
      "title": "Питание / Громкость",
      "controls": [
        {
          "type": "button",
          "label": "Питание",
          "command": "power",
          "icon": "⏻"
        },
        {
          "type": "button",
          "label": "Vol +",
          "command": "volumeUp"
        },
        {
          "type": "button",
          "label": "Vol -",
          "command": "volumeDown"
        },
        {
          "type": "button",
          "label": "Без звука",
          "command": "mute"
        }
      ]
    },
    {
      "title": "Навигация",
      "controls": [
        {
          "type": "button",
          "label": "Вверх",
          "command": "up",
          "icon": "▲",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "Влево",
          "command": "left",
          "icon": "◀",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "OK",
          "command": "ok"
        },
        {
          "type": "button",
          "label": "Вправо",
          "command": "right",
          "icon": "▶",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "Вниз",
          "command": "down",
          "icon": "▼",
          "iconOnly": true
        },
        {
          "type": "button",
          "label": "Назад",
          "command": "back"
        },
        {
          "type": "button",
          "label": "Главная",
          "command": "home"
        },
        {
          "type": "button",
          "label": "Источник",
          "command": "source"
        }
      ]
    }
  ]
}
