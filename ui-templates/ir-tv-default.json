{
  "$schema": "../schemas/device-ui-template-v2.schema.json",
  "schemaVersion": 2,
  "id": "ir-tv-default",
  "name": "TV remote",
  "deviceTypeId": "television",
  "connections": ["infrared"],
  "renderer": "declarative",
  "access": "free",

  "columns": 4,
  "useFullWidth": true,
  "horizontalSpacing": 8,
  "verticalSpacing": 10,
  "screenMarginLeft": 12,
  "screenMarginTop": 12,
  "screenMarginRight": 12,
  "screenMarginBottom": 18,

  "backgroundMode": "vertical-gradient",
  "backgroundColor": "#0A1220",
  "backgroundColor2": "#0D1728",
  "foregroundColor": "#F4F7FB",
  "mutedTextColor": "#A8B6CB",
  "surfaceColor": "#111D31",
  "accentColor": "#4EA1FF",
  "buttonColor": "#1B2940",
  "buttonTextColor": "#F7FAFF",
  "borderColor": "#31425E",

  "buttonCornerRadius": 10,
  "sectionCornerRadius": 16,
  "buttonHeight": 50,
  "buttonFontSize": 13,
  "iconFontSize": 24,

  "groups": [
    {
      "id": "power-row",
      "name": "Power",
      "titlePlacement": "border",
      "order": 10,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 16,
      "borderColor": "#344763",
      "borderWidth": 1,
      "backgroundMode": "solid",
      "backgroundColor": "#101B2E",
      "controls": [
        { "id": "power", "order": 10, "type": "button", "label": "POWER", "command": "Power", "row": 0, "column": 0, "sizeYPercent": 82, "shape": "rounded", "backgroundColor": "#C83E4D", "textColor": "#FFFFFF", "borderWidth": 0 },
        { "id": "source", "order": 20, "type": "button", "label": "INPUT", "command": "Source", "row": 0, "column": 1, "sizeYPercent": 82, "shape": "rectangle", "backgroundColor": "#483D8B", "textColor": "#FFFFFF", "borderWidth": 0 },
        { "id": "home", "order": 30, "type": "button", "label": "HOME", "command": "SmartHub", "row": 0, "column": 2, "sizeYPercent": 82, "shape": "rounded", "backgroundColor": "#246BCE", "textColor": "#FFFFFF", "borderWidth": 0 },
        { "id": "settings", "order": 40, "type": "button", "label": "TOOLS", "command": "Tools", "row": 0, "column": 3, "sizeYPercent": 82, "shape": "rectangle", "backgroundColor": "#334155", "textColor": "#FFFFFF", "borderWidth": 0 }
      ]
    },

    {
      "id": "volume-channel",
      "name": "Volume & Channel",
      "titlePlacement": "border",
      "order": 20,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 16,
      "borderColor": "#344763",
      "backgroundMode": "solid",
      "backgroundColor": "#101B2E",
      "controls": [
        { "id": "vol-up", "order": 10, "type": "button", "label": "VOL +", "command": "VolumeUp", "row": 0, "column": 0, "sizeYPercent": 82, "backgroundColor": "#1E4976" },
        { "id": "mute", "order": 20, "type": "button", "label": "MUTE", "command": "Mute", "row": 0, "column": 1, "columnSpan": 2, "sizeYPercent": 82, "shape": "rectangle", "backgroundColor": "#735C1F", "textColor": "#FFF7D6" },
        { "id": "ch-up", "order": 30, "type": "button", "label": "CH +", "command": "ChannelUp", "row": 0, "column": 3, "sizeYPercent": 82, "backgroundColor": "#185A55" },
        { "id": "vol-down", "order": 40, "type": "button", "label": "VOL −", "command": "VolumeDown", "row": 1, "column": 0, "sizeYPercent": 82, "backgroundColor": "#1E4976" },
        { "id": "previous-channel", "order": 50, "type": "button", "label": "LAST", "command": "PreviousChannel", "row": 1, "column": 1, "columnSpan": 2, "sizeYPercent": 82, "shape": "rectangle", "backgroundColor": "#253650" },
        { "id": "ch-down", "order": 60, "type": "button", "label": "CH −", "command": "ChannelDown", "row": 1, "column": 3, "sizeYPercent": 82, "backgroundColor": "#185A55" }
      ]
    },

    {
      "id": "navigation",
      "name": "Navigation",
      "titlePlacement": "border",
      "order": 30,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 20,
      "borderColor": "#41658E",
      "borderWidth": 1.5,
      "backgroundMode": "vertical-gradient",
      "backgroundColor": "#121F35",
      "backgroundColor2": "#0F1A2C",
      "controls": [
        { "id": "up", "order": 10, "type": "button", "label": "▲", "command": "Up", "row": 0, "column": 1, "columnSpan": 2, "sizeYPercent": 86, "backgroundColor": "#243D63", "fontSize": 21, "borderWidth": 0 },
        { "id": "left", "order": 20, "type": "button", "label": "◀", "command": "Left", "row": 1, "column": 0, "sizeYPercent": 90, "shape": "rectangle", "backgroundColor": "#243D63", "fontSize": 21, "borderWidth": 0 },
        { "id": "ok", "order": 30, "type": "button", "label": "OK", "command": "Ok", "row": 1, "column": 1, "columnSpan": 2, "sizeYPercent": 94, "backgroundColor": "#2F80ED", "textColor": "#FFFFFF", "fontSize": 17, "fontAttribute": "bold", "borderColor": "#76B6FF", "borderWidth": 1 },
        { "id": "right", "order": 40, "type": "button", "label": "▶", "command": "Right", "row": 1, "column": 3, "sizeYPercent": 90, "shape": "rectangle", "backgroundColor": "#243D63", "fontSize": 21, "borderWidth": 0 },
        { "id": "back", "order": 50, "type": "button", "label": "BACK", "command": "Back", "row": 2, "column": 0, "sizeYPercent": 82, "shape": "rectangle", "backgroundColor": "#3B4658", "borderWidth": 0 },
        { "id": "down", "order": 60, "type": "button", "label": "▼", "command": "Down", "row": 2, "column": 1, "columnSpan": 2, "sizeYPercent": 86, "backgroundColor": "#243D63", "fontSize": 21, "borderWidth": 0 },
        { "id": "exit", "order": 70, "type": "button", "label": "EXIT", "command": "Exit", "row": 2, "column": 3, "sizeYPercent": 82, "shape": "rectangle", "backgroundColor": "#5A3544", "borderWidth": 0 }
      ]
    },

    {
      "id": "main-actions",
      "name": "TV",
      "titlePlacement": "border",
      "order": 40,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 14,
      "borderColor": "#2D3E58",
      "backgroundMode": "solid",
      "backgroundColor": "#0F192A",
      "controls": [
        { "id": "menu", "order": 10, "type": "button", "label": "MENU", "command": "Menu", "row": 0, "column": 0, "sizeYPercent": 78 },
        { "id": "guide", "order": 20, "type": "button", "label": "GUIDE", "command": "Guide", "row": 0, "column": 1, "sizeYPercent": 78 },
        { "id": "info", "order": 30, "type": "button", "label": "INFO", "command": "Info", "row": 0, "column": 2, "sizeYPercent": 78 },
        { "id": "channel-list", "order": 40, "type": "button", "label": "CH LIST", "command": "ChannelList", "row": 0, "column": 3, "sizeYPercent": 78 }
