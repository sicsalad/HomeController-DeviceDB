{
  "$schema": "../schemas/device-ui-template-v2.schema.json",
  "schemaVersion": 2,
  "id": "ir-tv-default",
  "name": "TV remote",
  "deviceTypeId": "television",
  "connections": ["infrared"],
  "renderer": "declarative",
  "access": "free",

  "columns": 4,
  "useFullWidth": true,
  "horizontalSpacing": 8,
  "verticalSpacing": 10,
  "screenMarginLeft": 10,
  "screenMarginTop": 10,
  "screenMarginRight": 10,
  "screenMarginBottom": 16,

  "buttonCornerRadius": 18,
  "sectionCornerRadius": 22,
  "buttonHeight": 58,
  "buttonFontSize": 13,
  "iconFontSize": 24,

  "groups": [
    {
      "id": "power-row",
      "name": "Power",
      "order": 10,
      "columnSpan": 4,
      "controls": [
        {
          "id": "power",
          "order": 10,
          "type": "button",
          "label": "POWER",
          "command": "Power",
          "row": 0,
          "column": 0,
          "height": 64,
          "shape": "pill",
          "backgroundColor": "$Danger",
          "textColor": "$OnDanger"
        },
        {
          "id": "source",
          "order": 20,
          "type": "button",
          "label": "INPUT",
          "command": "Source",
          "row": 0,
          "column": 1,
          "height": 64,
          "shape": "pill"
        },
        {
          "id": "home",
          "order": 30,
          "type": "button",
          "label": "HOME",
          "command": "SmartHub",
          "row": 0,
          "column": 2,
          "height": 64,
          "shape": "pill"
        },
        {
          "id": "settings",
          "order": 40,
          "type": "button",
          "label": "TOOLS",
          "command": "Tools",
          "row": 0,
          "column": 3,
          "height": 64,
          "shape": "pill"
        }
      ]
    },

    {
      "id": "volume-channel",
      "name": "Volume & Channel",
      "order": 20,
      "columnSpan": 4,
      "controls": [
        {
          "id": "vol-up",
          "order": 10,
          "type": "button",
          "label": "VOL +",
          "command": "VolumeUp",
          "row": 0,
          "column": 0,
          "height": 62
        },
        {
          "id": "mute",
          "order": 20,
          "type": "button",
          "label": "MUTE",
          "command": "Mute",
          "row": 0,
          "column": 1,
          "columnSpan": 2,
          "height": 62
        },
        {
          "id": "ch-up",
          "order": 30,
          "type": "button",
          "label": "CH +",
          "command": "ChannelUp",
          "row": 0,
          "column": 3,
          "height": 62
        },
        {
          "id": "vol-down",
          "order": 40,
          "type": "button",
          "label": "VOL −",
          "command": "VolumeDown",
          "row": 1,
          "column": 0,
          "height": 62
        },
        {
          "id": "previous-channel",
          "order": 50,
          "type": "button",
          "label": "LAST",
          "command": "PreviousChannel",
          "row": 1,
          "column": 1,
          "columnSpan": 2,
          "height": 62
        },
        {
          "id": "ch-down",
          "order": 60,
          "type": "button",
          "label": "CH −",
          "command": "ChannelDown",
          "row": 1,
          "column": 3,
          "height": 62
        }
      ]
    },

    {
      "id": "navigation",
      "name": "Navigation",
      "order": 30,
      "columnSpan": 4,
      "rowSpan": 3,
      "backgroundMode": "inherit",
      "cornerRadius": 24,
      "controls": [
        {
          "id": "up",
          "order": 10,
          "type": "button",
          "label": "▲",
          "command": "Up",
          "row": 0,
          "column": 1,
          "columnSpan": 2,
          "height": 66,
          "shape": "pill",
          "fontSize": 22
        },
        {
          "id": "left",
          "order": 20,
          "type": "button",
          "label": "◀",
          "command": "Left",
          "row": 1,
          "column": 0,
          "height": 72,
          "shape": "pill",
          "fontSize": 22
        },
        {
          "id": "ok",
          "order": 30,
          "type": "button",
          "label": "OK",
          "command": "Ok",
          "row": 1,
          "column": 1,
          "columnSpan": 2,
          "height": 76,
          "shape": "pill",
          "backgroundColor": "$Accent",
          "textColor": "$OnAccent",
          "fontSize": 17
        },
        {
          "id": "right",
          "order": 40,
          "type": "button",
          "label": "▶",
          "command": "Right",
          "row": 1,
          "column": 3,
          "height": 72,
          "shape": "pill",
          "fontSize": 22
        },
        {
          "id": "back",
          "order": 50,
          "type": "button",
          "label": "BACK",
          "command": "Back",
          "row": 2,
          "column": 0,
          "height": 66,
          "shape": "pill"
        },
        {
          "id": "down",
          "order": 60,
          "type": "button",
          "label": "▼",
          "command": "Down",
          "row": 2,
          "column": 1,
          "columnSpan": 2,
          "height": 66,
          "shape": "pill",
          "fontSize": 22
        },
        {
          "id": "exit",
          "order": 70,
          "type": "button",
          "label": "EXIT",
          "command": "Exit",
          "row": 2,
          "column": 3,
          "height": 66,
          "shape": "pill"
        }
      ]
    },

    {
      "id": "main-actions",
      "name": "TV",
      "order": 40,
      "columnSpan": 4,
      "controls": [
        { "id": "menu", "order": 10, "type": "button", "label": "MENU", "command": "Menu", "row": 0, "column": 0 },
        { "id": "guide", "order": 20, "type": "button", "label": "GUIDE", "command": "Guide", "row": 0, "column": 1 },
        { "id": "info", "order": 30, "type": "button", "label": "INFO", "command": "Info", "row": 0, "column": 2 },
        { "id": "channel-list", "order": 40, "type": "button", "label": "CH LIST", "command": "ChannelList", "row": 0, "column": 3 }
      ]
    },

    {
      "id": "number-pad",
      "name": "Numbers",
      "order": 50,
      "columnSpan": 4,
      "controls": [
        { "id": "digit1", "order": 10, "type": "button", "label": "1", "command": "Digit1", "row": 0, "column": 0, "fontSize": 18 },
        { "id": "digit2", "order": 20, "type": "button", "label": "2", "command": "Digit2", "row": 0, "column": 1, "fontSize": 18 },
        { "id": "digit3", "order": 30, "type": "button", "label": "3", "command": "Digit3", "row": 0, "column": 2, "fontSize": 18 },
        { "id": "subtitle", "order": 40, "type": "button", "label": "SUB", "command": "Subtitle", "row": 0, "column": 3 },

        { "id": "digit4", "order": 50, "type": "button", "label": "4", "command": "Digit4", "row": 1, "column": 0, "fontSize": 18 },
        { "id": "digit5", "order": 60, "type": "button", "label": "5", "command": "Digit5", "row": 1, "column": 1, "fontSize": 18 },
        { "id": "digit6", "order": 70, "type": "button", "label": "6", "command": "Digit6", "row": 1, "column": 2, "fontSize": 18 },
        { "id": "teletext", "order": 80, "type": "button", "label": "TEXT", "command": "TeletextMix", "row": 1, "column": 3 },

        { "id": "digit7", "order": 90, "type": "button", "label": "7", "command": "Digit7", "row": 2, "column": 0, "fontSize": 18 },
        { "id": "digit8", "order": 100, "type": "button", "label": "8", "command": "Digit8", "row": 2, "column": 1, "fontSize": 18 },
        { "id": "digit9", "order": 110, "type": "button", "label": "9", "command": "Digit9", "row": 2, "column": 2, "fontSize": 18 },
        { "id": "emanual", "order": 120, "type": "button", "label": "E-MANUAL", "command": "EManual", "row": 2, "column": 3, "fontSize": 11 },

        { "id": "digit0", "order": 130, "type": "button", "label": "0", "command": "Digit0", "row": 3, "column": 1, "columnSpan": 2, "fontSize": 18 }
      ]
    },

    {
      "id": "media",
      "name": "Media",
      "order": 60,
      "columnSpan": 4,
      "controls": [
        { "id": "rewind", "order": 10, "type": "button", "label": "REW", "command": "Rewind", "row": 0, "column": 0 },
        { "id": "play", "order": 20, "type": "button", "label": "PLAY", "command": "Play", "row": 0, "column": 1 },
        { "id": "pause", "order": 30, "type": "button", "label": "PAUSE", "command": "Pause", "row": 0, "column": 2 },
        { "id": "forward", "order": 40, "type": "button", "label": "FF", "command": "FastForward", "row": 0, "column": 3 },
        { "id": "stop", "order": 50, "type": "button", "label": "STOP", "command": "Stop", "row": 1, "column": 1 },
        { "id": "record", "order": 60, "type": "button", "label": "REC", "command": "Record", "row": 1, "column": 2, "backgroundColor": "$Danger", "textColor": "$OnDanger" }
      ]
    },

    {
      "id": "color-buttons",
      "name": "Color Keys",
      "order": 70,
      "columnSpan": 4,
      "controls": [
        { "id": "red", "order": 10, "type": "button", "label": "", "command": "Red", "row": 0, "column": 0, "height": 48, "shape": "pill", "backgroundColor": "#D32F2F" },
        { "id": "green", "order": 20, "type": "button", "label": "", "command": "Green", "row": 0, "column": 1, "height": 48, "shape": "pill", "backgroundColor": "#388E3C" },
        { "id": "yellow", "order": 30, "type": "button", "label": "", "command": "Yellow", "row": 0, "column": 2, "height": 48, "shape": "pill", "backgroundColor": "#FBC02D" },
        { "id": "blue", "order": 40, "type": "button", "label": "", "command": "Blue", "row": 0, "column": 3, "height": 48, "shape": "pill", "backgroundColor": "#1976D2" }
      ]
    },

    {
      "id": "extended-tv",
      "name": "More",
      "order": 80,
      "columnSpan": 4,
      "controls": [
        { "id": "power-on", "order": 10, "type": "button", "label": "POWER ON", "command": "PowerOn", "row": 0, "column": 0, "columnSpan": 2 },
        { "id": "power-off", "order": 20, "type": "button", "label": "POWER OFF", "command": "PowerOff", "row": 0, "column": 2, "columnSpan": 2 },
        { "id": "soccer-mode", "order": 30, "type": "button", "label": "SPORT", "command": "SoccerMode", "row": 1, "column": 0 },
        { "id": "sleep", "order": 40, "type": "button", "label": "SLEEP", "command": "Sleep", "row": 1, "column": 1 },
        { "id": "custom1", "order": 50, "type": "button", "label": "APP 1", "command": "Custom1", "row": 1, "column": 2 },
        { "id": "custom2", "order": 60, "type": "button", "label": "APP 2", "command": "Custom2", "row": 1, "column": 3 },
        { "id": "custom3", "order": 70, "type": "button", "label": "APP 3", "command": "Custom3", "row": 2, "column": 0 },
        { "id": "custom4", "order": 80, "type": "button", "label": "APP 4", "command": "Custom4", "row": 2, "column": 1 },
        { "id": "custom5", "order": 90, "type": "button", "label": "APP 5", "command": "Custom5", "row": 2, "column": 2 },
        { "id": "custom6", "order": 100, "type": "button", "label": "APP 6", "command": "Custom6", "row": 2, "column": 3 },
        { "id": "custom7", "order": 110, "type": "button", "label": "CUSTOM 7", "command": "Custom7", "row": 3, "column": 1 },
        { "id": "custom8", "order": 120, "type": "button", "label": "CUSTOM 8", "command": "Custom8", "row": 3, "column": 2 }
      ]
    }
  ]
}