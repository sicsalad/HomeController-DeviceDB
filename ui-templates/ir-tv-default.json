{
  "$schema": "../schemas/device-ui-template-v2.schema.json",
  "schemaVersion": 2,
  "id": "ir-tv-default",
  "name": "TV remote",
  "deviceTypeId": "television",
  "connections": ["infrared"],
  "renderer": "builtin-ir-tv",
  "access": "free",
  "columns": 3,
  "useFullWidth": true,
  "horizontalSpacing": 8,
  "verticalSpacing": 8,
  "screenMarginLeft": 12,
  "screenMarginTop": 12,
  "screenMarginRight": 12,
  "screenMarginBottom": 12,
  "backgroundColor": "$PageBackground",
  "foregroundColor": "$TextPrimary",
  "mutedTextColor": "$TextMuted",
  "surfaceColor": "$Surface",
  "accentColor": "$Accent",
  "buttonColor": "$ButtonBackground",
  "buttonTextColor": "$ButtonText",
  "borderColor": "$CardBorder",
  "buttonCornerRadius": 12,
  "sectionCornerRadius": 14,
  "buttonHeight": 52,
  "buttonFontSize": 14,
  "iconFontSize": 24,
  "itemDefaults": {
    "shape": "rounded",
    "cornerRadius": 12,
    "showIcon": true,
    "showName": true,
    "showType": false,
    "showState": true
  },
  "initialStates": {},
  "integrationChildPresentations": {}
}
