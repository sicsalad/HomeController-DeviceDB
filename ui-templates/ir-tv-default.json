      "order": 50,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 14,
      "borderColor": "#2D3E58",
      "backgroundMode": "solid",
      "backgroundColor": "#0F192A",
      "controls": [
        { "id": "digit1", "order": 10, "type": "button", "label": "1", "command": "Digit1", "row": 0, "column": 0, "sizeYPercent": 80, "fontSize": 18 },
        { "id": "digit2", "order": 20, "type": "button", "label": "2", "command": "Digit2", "row": 0, "column": 1, "sizeYPercent": 80, "fontSize": 18 },
        { "id": "digit3", "order": 30, "type": "button", "label": "3", "command": "Digit3", "row": 0, "column": 2, "sizeYPercent": 80, "fontSize": 18 },
        { "id": "subtitle", "order": 40, "type": "button", "label": "SUB", "command": "Subtitle", "row": 0, "column": 3, "sizeYPercent": 80, "backgroundColor": "#263A55" },

        { "id": "digit4", "order": 50, "type": "button", "label": "4", "command": "Digit4", "row": 1, "column": 0, "sizeYPercent": 80, "fontSize": 18 },
        { "id": "digit5", "order": 60, "type": "button", "label": "5", "command": "Digit5", "row": 1, "column": 1, "sizeYPercent": 80, "fontSize": 18 },
        { "id": "digit6", "order": 70, "type": "button", "label": "6", "command": "Digit6", "row": 1, "column": 2, "sizeYPercent": 80, "fontSize": 18 },
        { "id": "teletext", "order": 80, "type": "button", "label": "TEXT", "command": "TeletextMix", "row": 1, "column": 3, "sizeYPercent": 80, "backgroundColor": "#263A55" },

        { "id": "digit7", "order": 90, "type": "button", "label": "7", "command": "Digit7", "row": 2, "column": 0, "sizeYPercent": 80, "fontSize": 18 },
        { "id": "digit8", "order": 100, "type": "button", "label": "8", "command": "Digit8", "row": 2, "column": 1, "sizeYPercent": 80, "fontSize": 18 },
        { "id": "digit9", "order": 110, "type": "button", "label": "9", "command": "Digit9", "row": 2, "column": 2, "sizeYPercent": 80, "fontSize": 18 },
        { "id": "emanual", "order": 120, "type": "button", "label": "E-MANUAL", "command": "EManual", "row": 2, "column": 3, "sizeYPercent": 80, "fontSize": 10, "backgroundColor": "#263A55" },

        { "id": "digit0", "order": 130, "type": "button", "label": "0", "command": "Digit0", "row": 3, "column": 1, "columnSpan": 2, "sizeYPercent": 82, "fontSize": 18, "backgroundColor": "#23344E" }
      ]
    },

    {
      "id": "media",
      "name": "Media",
      "titlePlacement": "border",
      "order": 60,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 14,
      "borderColor": "#2D3E58",
      "backgroundMode": "solid",
      "backgroundColor": "#0F192A",
      "controls": [
        { "id": "rewind", "order": 10, "type": "button", "label": "REW", "command": "Rewind", "row": 0, "column": 0, "sizeYPercent": 78, "shape": "rectangle", "backgroundColor": "#213451" },
        { "id": "play", "order": 20, "type": "button", "label": "PLAY", "command": "Play", "row": 0, "column": 1, "sizeYPercent": 78, "backgroundColor": "#1B5A45" },
        { "id": "pause", "order": 30, "type": "button", "label": "PAUSE", "command": "Pause", "row": 0, "column": 2, "sizeYPercent": 78, "backgroundColor": "#735C1F" },
        { "id": "forward", "order": 40, "type": "button", "label": "FF", "command": "FastForward", "row": 0, "column": 3, "sizeYPercent": 78, "shape": "rectangle", "backgroundColor": "#213451" },
        { "id": "stop", "order": 50, "type": "button", "label": "STOP", "command": "Stop", "row": 1, "column": 1, "sizeYPercent": 76, "backgroundColor": "#4A4352" },
        { "id": "record", "order": 60, "type": "button", "label": "REC", "command": "Record", "row": 1, "column": 2, "sizeYPercent": 76, "backgroundColor": "#B63848", "textColor": "#FFFFFF" }
      ]
    },

    {
      "id": "color-buttons",
      "name": "Color Keys",
      "titlePlacement": "border",
      "order": 70,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 12,
      "borderColor": "#2D3E58",
      "backgroundMode": "solid",
      "backgroundColor": "#0F192A",
      "controls": [
        { "id": "red", "order": 10, "type": "button", "label": "", "command": "Red", "row": 0, "column": 0, "sizeYPercent": 56, "shape": "rectangle", "backgroundColor": "#D84545", "borderWidth": 0 },
        { "id": "green", "order": 20, "type": "button", "label": "", "command": "Green", "row": 0, "column": 1, "sizeYPercent": 56, "shape": "rectangle", "backgroundColor": "#35A65A", "borderWidth": 0 },
        { "id": "yellow", "order": 30, "type": "button", "label": "", "command": "Yellow", "row": 0, "column": 2, "sizeYPercent": 56, "shape": "rectangle", "backgroundColor": "#E4B936", "borderWidth": 0 },
        { "id": "blue", "order": 40, "type": "button", "label": "", "command": "Blue", "row": 0, "column": 3, "sizeYPercent": 56, "shape": "rectangle", "backgroundColor": "#3986E6", "borderWidth": 0 }
      ]
    },

    {
      "id": "extended-tv",
      "name": "More",
      "titlePlacement": "border",
      "order": 80,
      "columnSpan": 4,
      "shape": "rounded",
      "cornerRadius": 14,
      "borderColor": "#2D3E58",
      "backgroundMode": "solid",
      "backgroundColor": "#0F192A",
      "controls": [
        { "id": "power-on", "order": 10, "type": "button", "label": "POWER ON", "command": "PowerOn", "row": 0, "column": 0, "columnSpan": 2, "sizeYPercent": 76, "backgroundColor": "#245E45" },
        { "id": "power-off", "order": 20, "type": "button", "label": "POWER OFF", "command": "PowerOff", "row": 0, "column": 2, "columnSpan": 2, "sizeYPercent": 76, "backgroundColor": "#6B3340" },
        { "id": "soccer-mode", "order": 30, "type": "button", "label": "SPORT", "command": "SoccerMode", "row": 1, "column": 0, "sizeYPercent": 74, "backgroundColor": "#215746" },
        { "id": "sleep", "order": 40, "type": "button", "label": "SLEEP", "command": "Sleep", "row": 1, "column": 1, "sizeYPercent": 74, "backgroundColor": "#3C416C" },
        { "id": "custom1", "order": 50, "type": "button", "label": "APP 1", "command": "Custom1", "row": 1, "column": 2, "sizeYPercent": 74 },
        { "id": "custom2", "order": 60, "type": "button", "label": "APP 2", "command": "Custom2", "row": 1, "column": 3, "sizeYPercent": 74 },
        { "id": "custom3", "order": 70, "type": "button", "label": "APP 3", "command": "Custom3", "row": 2, "column": 0, "sizeYPercent": 74 },
        { "id": "custom4", "order": 80, "type": "button", "label": "APP 4", "command": "Custom4", "row": 2, "column": 1, "sizeYPercent": 74 },
        { "id": "custom5", "order": 90, "type": "button", "label": "APP 5", "command": "Custom5", "row": 2, "column": 2, "sizeYPercent": 74 },
        { "id": "custom6", "order": 100, "type": "button", "label": "APP 6", "command": "Custom6", "row": 2, "column": 3, "sizeYPercent": 74 },
        { "id": "custom7", "order": 110, "type": "button", "label": "APP 7", "command": "Custom7", "row": 3, "column": 1, "sizeYPercent": 74 },
        { "id": "custom8", "order": 120, "type": "button", "label": "APP 8", "command": "Custom8", "row": 3, "column": 2, "sizeYPercent": 74 }
      ]
    }
