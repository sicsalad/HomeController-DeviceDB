{
  "schemaVersion": 1,
  "id": "ir-tv-round",
  "name": "Round TV Remote",
  "deviceTypeId": "television",
  "connections": ["infrared"],
  "renderer": "declarative",
  "columns": 5,
  "backgroundColor": "#101214",
  "foregroundColor": "#F2F4F5",
  "mutedTextColor": "#9AA1A8",
  "surfaceColor": "#171A1D",
  "accentColor": "#D97732",
  "buttonColor": "#292D31",
  "buttonTextColor": "#F7F8F8",
  "borderColor": "#40454A",
  "buttonCornerRadius": 16,
  "sectionCornerRadius": 18,
  "buttonHeight": 58,
  "buttonFontSize": 11,
  "iconFontSize": 24,
  "sections": [
    {"subtitle":"Power and quick actions","controls":[
      {"type":"tile","label":"","command":"Power","icon":"⏻","iconOnly":true,"shape":"circle","height":60,"backgroundColor":"#713337","borderColor":"#9A4A4F"},
      {"type":"tile","label":"MUTE","command":"Mute","icon":"🔇","shape":"circle","height":60},
      {"type":"tile","label":"INFO","command":"Info","icon":"ⓘ","shape":"circle","height":60},
      {"type":"tile","label":"MENU","command":"Menu","icon":"☰","shape":"circle","height":60},
      {"type":"tile","label":"SOURCE","command":"Source","icon":"▣","shape":"circle","height":60}
    ]},
    {"title":"NAVIGATION","controls":[
      {"type":"tile","label":"VOL +","command":"VolumeUp","icon":"＋","shape":"pill","height":58},
      {"type":"tile","label":"","command":"Up","icon":"▲","iconOnly":true,"shape":"circle","height":62,"columnSpan":3,"backgroundColor":"#71401F","borderColor":"#9B5A2A"},
      {"type":"tile","label":"CH +","command":"ChannelUp","icon":"＋","shape":"pill","height":58},
      {"type":"tile","label":"VOL −","command":"VolumeDown","icon":"−","shape":"pill","height":58},
      {"type":"tile","label":"","command":"Left","icon":"◀","iconOnly":true,"shape":"circle","height":62,"backgroundColor":"#71401F","borderColor":"#9B5A2A"},
      {"type":"tile","label":"OK","command":"Ok","shape":"circle","height":68,"backgroundColor":"#3A3F44","borderColor":"#777F87"},
      {"type":"tile","label":"","command":"Right","icon":"▶","iconOnly":true,"shape":"circle","height":62,"backgroundColor":"#71401F","borderColor":"#9B5A2A"},
      {"type":"tile","label":"CH −","command":"ChannelDown","icon":"−","shape":"pill","height":58},
      {"type":"tile","label":"BACK","command":"Back","icon":"↩","shape":"pill","height":54},
      {"type":"tile","label":"","command":"Down","icon":"▼","iconOnly":true,"shape":"circle","height":62,"columnSpan":3,"backgroundColor":"#71401F","borderColor":"#9B5A2A"},
      {"type":"tile","label":"GUIDE","command":"Guide","icon":"▤","shape":"pill","height":54}
    ]},
    {"title":"COLOUR KEYS","controls":[
      {"type":"tile","label":"","command":"Red","icon":"●","iconOnly":true,"shape":"circle","height":48,"backgroundColor":"#6E3036","borderColor":"#93444A"},
      {"type":"tile","label":"","command":"Green","icon":"●","iconOnly":true,"shape":"circle","height":48,"backgroundColor":"#315B46","borderColor":"#477D61"},
      {"type":"tile","label":"","command":"Yellow","icon":"●","iconOnly":true,"shape":"circle","height":48,"backgroundColor":"#6A5A2D","borderColor":"#8C783E"},
      {"type":"tile","label":"","command":"Blue","icon":"●","iconOnly":true,"shape":"circle","height":48,"backgroundColor":"#304F70","borderColor":"#416C96"},
      {"type":"tile","label":"TOOLS","command":"Tools","icon":"⚙","shape":"circle","height":48}
    ]},
    {"title":"MEDIA","controls":[
      {"type":"tile","label":"","command":"Rewind","icon":"⏪","iconOnly":true,"shape":"circle","height":52},
      {"type":"tile","label":"","command":"Play","icon":"▶","iconOnly":true,"shape":"circle","height":52},
      {"type":"tile","label":"","command":"Pause","icon":"Ⅱ","iconOnly":true,"shape":"circle","height":52},
      {"type":"tile","label":"","command":"FastForward","icon":"⏩","iconOnly":true,"shape":"circle","height":52},
      {"type":"tile","label":"STOP","command":"Stop","icon":"■","shape":"circle","height":52}
    ]}
