{
  "$schema": "../schemas/device-ui-template-v2.schema.json",
  "schemaVersion": 2,
  "id": "google-home-default",
  "name": "Google Home default",
  "deviceTypeId": "google-home",
  "connections": ["wifi"],
  "renderer": "declarative",
  "access": "free",
  "columns": 1,
  "useFullWidth": true,
  "horizontalSpacing": 5,
  "verticalSpacing": 5,
  "screenMarginLeft": 0,
  "screenMarginTop": 0,
  "screenMarginRight": 0,
  "screenMarginBottom": 0,
  "backgroundColor": "$PageBackground",
  "foregroundColor": "$TextPrimary",
  "mutedTextColor": "$TextMuted",
  "surfaceColor": "$Surface",
  "accentColor": "$Accent",
  "buttonColor": "$ButtonBackground",
  "buttonTextColor": "$ButtonText",
  "borderColor": "$CardBorder",
  "buttonCornerRadius": 8,
  "sectionCornerRadius": 14,
  "buttonHeight": 54,
  "buttonFontSize": 13,
  "iconFontSize": 24,
  "groups": [
    {
      "id": "google-home-managed-items",
      "order": 0,
      "width": 1,
      "height": 1,
      "type": "normal",
      "shape": "rounded",
      "borderWidth": 0,
      "backgroundMode": "inherit",
      "cornerRadius": 14,
      "controls": [
        {
          "id": "google-home-managed-items-button",
          "order": 0,
          "type": "button",
          "text": "☑",
          "command": "integration:manage-items",
          "columnSpan": 1,
          "row": 0,
          "column": 0,
          "verticalAlign": "center",
          "sizeXPercent": 100,
          "sizeYPercent": 100,
          "borderWidth": 1
        }
      ],
      "groups": []
    },
    {
      "id": "google-home-type-filter",
      "order": 1,
      "width": 1,
      "height": 1,
      "type": "filter",
      "filterScope": "devices",
      "filterProperty": "category",
      "filterMode": "in",
      "filterAutoValues": true,
      "filterAutoItemMargin": 1,
      "filterAutoItemCornerRadius": 8,
      "filterAutoItemContent": "image",
      "shape": "rounded",
      "borderWidth": 0,
      "backgroundMode": "inherit",
      "cornerRadius": 14,
      "controls": [],
      "groups": []
    },
    {
      "id": "google-home-search-filter",
      "order": 2,
      "width": 1,
      "height": 1,
      "type": "filter",
      "filterScope": "devices",
      "filterProperty": "name",
      "filterMode": "contains",
      "shape": "rounded",
      "borderWidth": 0,
      "backgroundMode": "inherit",
      "cornerRadius": 14,
      "controls": [
        {
          "id": "google-home-search",
          "order": 0,
          "type": "edittext",
          "text": "Search",
          "columnSpan": 1,
          "row": 0,
          "column": 0,
          "verticalAlign": "center",
          "sizeXPercent": 100,
          "sizeYPercent": 100,
          "borderWidth": 1,
          "filterId": "google-home-search-filter"
        }
      ],
      "groups": []
    },
    {
      "id": "devices",
      "order": 3,
      "width": 1,
      "height": 1,
      "type": "child-items",
      "childItemsSource": "",
      "childItemsColumns": 2,
      "shape": "rounded",
      "borderWidth": 0,
      "backgroundMode": "inherit",
      "cornerRadius": 14,
      "controls": [],
      "groups": []
    }
  ],
  "initialStates": {},
  "integrationChildPresentations": {}
}
