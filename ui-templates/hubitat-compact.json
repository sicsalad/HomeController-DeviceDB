{
  "schemaVersion": 1,
  "id": "hubitat-compact",
  "name": "Hubitat Compact",
  "deviceTypeId": "hubitat",
  "connections": ["wifi"],
  "renderer": "builtin-hubitat",
  "columns": 3,
  "themeSwitcherText": "UI",
  "themeSwitcherOpacity": 0.72,
  "buttonCornerRadius": 12,
  "sectionCornerRadius": 12,
  "buttonHeight": 44,
  "buttonFontSize": 12,
  "iconFontSize": 20,
  "itemDefaults": {
    "columns": 3,
    "displayMode": "compact",
    "showIcon": true,
    "showName": true,
    "showType": false,
    "showState": true,
    "cornerRadius": 12
  },
  "itemStyles": {
    "switch": {"columns": 3, "showState": true},
    "dimmer": {"columns": 2, "displayMode": "card", "showType": true},
    "light": {"columns": 2, "displayMode": "card", "showType": true},
    "temperature": {"columns": 3, "showType": false},
    "motion": {"columns": 3, "showType": false},
    "contact": {"columns": 3, "showType": false}
  },
  "sections": []
}
