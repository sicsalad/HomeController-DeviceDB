{
  "$schema": "../schemas/device-ui-template-v1.schema.json",
  "schemaVersion": 1,
  "id": "wifi-tv-round",
  "name": "Круглый пульт ТВ",
  "deviceTypeId": "television",
  "connections": [
    "wifi"
  ],
  "renderer": "declarative",
  "columns": 5,
  "useFullWidth": true,
  "buttonCornerRadius": 16,
  "sectionCornerRadius": 18,
  "buttonHeight": 58,
  "buttonFontSize": 11,
  "iconFontSize": 24,
  "sections": [
    {
      "subtitle": "Питание и быстрые действия",
      "controls": [
        {
          "type": "tile",
          "label": "",
          "command": "power",
          "icon": "⏻",
          "iconOnly": true,
          "shape": "circle",
          "height": 60
        },
        {
          "type": "tile",
          "label": "БЕЗ ЗВУКА",
          "command": "mute",
          "icon": "🔇",
          "shape": "circle",
          "height": 60
        },
        {
          "type": "tile",
          "label": "МЕНЮ",
          "command": "menu",
          "icon": "☰",
          "shape": "circle",
          "height": 60
        },
        {
          "type": "tile",
          "label": "ИСТОЧНИК",
          "command": "source",
          "icon": "▣",
          "shape": "circle",
          "height": 60,
          "columnSpan": 2
        }
      ]
    },
    {
      "title": "НАВИГАЦИЯ",
      "controls": [
        {
          "type": "tile",
          "label": "VOL +",
          "command": "volumeUp",
          "icon": "＋",
          "shape": "pill",
          "height": 58
        },
        {
          "type": "tile",
          "label": "",
          "command": "up",
          "icon": "▲",
          "iconOnly": true,
          "shape": "circle",
          "height": 62,
          "columnSpan": 3
        },
        {
          "type": "tile",
          "label": "CH +",
          "command": "channelUp",
          "icon": "＋",
          "shape": "pill",
          "height": 58
        },
        {
          "type": "tile",
          "label": "VOL −",
          "command": "volumeDown",
          "icon": "−",
          "shape": "pill",
          "height": 58
        },
        {
          "type": "tile",
          "label": "",
          "command": "left",
          "icon": "◀",
          "iconOnly": true,
          "shape": "circle",
          "height": 62
        },
        {
          "type": "tile",
          "label": "OK",
          "command": "ok",
          "shape": "circle",
          "height": 68
        },
        {
          "type": "tile",
          "label": "",
          "command": "right",
          "icon": "▶",
          "iconOnly": true,
          "shape": "circle",
          "height": 62
        },
        {
          "type": "tile",
          "label": "CH −",
          "command": "channelDown",
          "icon": "−",
          "shape": "pill",
          "height": 58
        },
        {
          "type": "tile",
          "label": "BACK",
          "command": "back",
          "icon": "↩",
          "shape": "pill",
          "height": 54
        },
        {
          "type": "tile",
          "label": "",
          "command": "down",
          "icon": "▼",
          "iconOnly": true,
          "shape": "circle",
          "height": 62,
          "columnSpan": 3
        },
        {
          "type": "tile",
          "label": "HOME",
          "command": "home",
          "icon": "⌂",
          "shape": "pill",
          "height": 54
        }
      ]
    }
  ]
}
