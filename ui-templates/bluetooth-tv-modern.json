{
  "schemaVersion": 2,
  "id": "bluetooth-tv-modern",
  "name": "Modern",
  "deviceTypeId": "television",
  "connections": ["bluetooth"],
  "renderer": "declarative",
  "access": "free",
  "columns": 3,
  "buttonHeight": 58,
  "buttonCornerRadius": 29,
  "sectionCornerRadius": 20,
  "surfaceColor": "$Surface",
