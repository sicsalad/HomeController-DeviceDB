      {"type":"tile","label":"Home","icon":"⌂","command":"Home"},
      {"type":"tile","label":"Up","icon":"▲","command":"Up"},
      {"type":"tile","label":"Menu","icon":"☰","command":"Menu"},
      {"type":"tile","label":"Left","icon":"◀","command":"Left"},
      {"type":"tile","label":"OK","icon":"●","command":"Enter"},
      {"type":"tile","label":"Right","icon":"▶","command":"Right"},
      {"type":"tile","label":"Back","icon":"↩","command":"Back"},
      {"type":"tile","label":"Down","icon":"▼","command":"Down"},
      {"type":"tile","label":"Play","icon":"⏯","command":"PlayPause"}
