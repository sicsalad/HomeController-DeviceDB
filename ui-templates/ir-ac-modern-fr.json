{
  "$schema": "../schemas/device-ui-template-v1.schema.json",
  "schemaVersion": 1,
  "id": "ir-ac-modern",
  "name": "Climatisation moderne",
  "deviceTypeId": "air-conditioner",
  "connections": [
    "infrared"
  ],
  "renderer": "declarative",
  "columns": 4,
  "useFullWidth": true,
  "buttonCornerRadius": 10,
  "sectionCornerRadius": 16,
  "buttonHeight": 58,
  "buttonFontSize": 11,
  "iconFontSize": 24,
  "sections": [
    {
      "subtitle": "Commande de climatisation",
      "controls": [
        {
          "type": "tile",
          "label": "MARCHE/ARRÊT",
          "command": "Power",
          "icon": "⏻",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "MODE",
          "command": "Mode",
          "icon": "◫"
        },
        {
          "type": "tile",
          "label": "VENTIL.",
          "command": "FanSpeed",
          "icon": "✣"
        }
      ]
    },
    {
      "title": "TEMPÉRATURE",
      "controls": [
        {
          "type": "tile",
          "label": "TEMP −",
          "command": "TemperatureDown",
          "icon": "−",
          "columnSpan": 2,
          "height": 70,
          "iconSize": 31
        },
        {
          "type": "tile",
          "label": "TEMP +",
          "command": "TemperatureUp",
          "icon": "＋",
          "columnSpan": 2,
          "height": 70,
          "iconSize": 31
        }
      ]
    },
    {
      "title": "MODE",
      "controls": [
        {
          "type": "tile",
          "label": "AUTO",
          "command": "ModeAuto",
          "icon": "A"
        },
        {
          "type": "tile",
          "label": "FROID",
          "command": "ModeCool",
          "icon": "❄"
        },
        {
          "type": "tile",
          "label": "CHAUD",
          "command": "ModeHeat",
          "icon": "☀"
        },
        {
          "type": "tile",
          "label": "DRY",
          "command": "ModeDry",
          "icon": "◌"
        },
        {
          "type": "tile",
          "label": "VENTIL.",
          "command": "ModeFan",
          "icon": "✣",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "VENTIL. AUTO",
          "command": "FanSpeedAuto",
          "icon": "◎",
          "columnSpan": 2
        }
      ]
    },
    {
      "title": "FLUX D’AIR",
      "controls": [
        {
          "type": "tile",
          "label": "VENTIL. −",
          "command": "FanSpeedDown",
          "icon": "−"
        },
        {
          "type": "tile",
          "label": "VENTIL. +",
          "command": "FanSpeedUp",
          "icon": "＋"
        },
        {
          "type": "tile",
          "label": "SWING",
          "command": "Swing",
          "icon": "↕",
          "columnSpan": 2
        }
      ]
    },
    {
      "title": "CONFORT & ÉNERGIE",
      "controls": [
        {
          "type": "tile",
          "label": "TURBO",
          "command": "Turbo",
          "icon": "⚡"
        },
        {
          "type": "tile",
          "label": "SILENCE",
          "command": "Quiet",
          "icon": "◔"
        },
        {
          "type": "tile",
          "label": "ECO",
          "command": "Economy",
          "icon": "♧"
        },
        {
          "type": "tile",
          "label": "SLEEP",
          "command": "Sleep",
          "icon": "☾"
        },
        {
          "type": "tile",
          "label": "ECO",
          "command": "PowerSave",
          "icon": "◒",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "LUMIÈRE",
          "command": "Light",
          "icon": "☼",
          "columnSpan": 2
        }
      ]
    },
    {
      "title": "PLUS",
      "controls": [
        {
          "type": "tile",
          "label": "AUTO-NETTOYAGE",
          "command": "SelfClean",
          "icon": "✦",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "X-FAN",
          "command": "XFanCleaning",
          "icon": "≈",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "I FEEL",
          "command": "IFeel",
          "icon": "⌖",
          "columnSpan": 2
        },
        {
          "type": "tile",
          "label": "TIMER",
          "command": "Timer",
          "icon": "◷",
          "columnSpan": 2
        }
      ]
    }
