{
  "$schema": "../schemas/device-ui-template-v1.schema.json",
  "schemaVersion": 1,
  "id": "wifi-ac-modern",
  "name": "Moderne Klimaanlage",
  "deviceTypeId": "air-conditioner",
  "connections": [
    "wifi"
  ],
  "renderer": "declarative",
  "columns": 4,
  "useFullWidth": true,
  "buttonCornerRadius": 10,
  "sectionCornerRadius": 16,
  "buttonHeight": 58,
  "buttonFontSize": 11,
  "iconFontSize": 24,
  "sections": [
    {
      "subtitle": "Klimasteuerung",
      "controls": [
        {
          "type": "toggle",
          "label": "EIN/AUS",
          "command": "power",
          "icon": "⏻",
          "columnSpan": 2
        },
        {
          "type": "picker",
          "label": "MODUS",
          "command": "mode",
          "options": [
            "Auto",
            "Cool",
            "Heat",
            "Dry",
            "Fan"
          ],
          "columnSpan": 2
        }
      ]
    },
    {
      "title": "TEMPERATUR",
      "subtitle": "Zieltemperatur",
      "controls": [
        {
          "type": "stepper",
          "label": "TEMPERATUR EINSTELLEN",
          "command": "targetTemperature",
          "minimum": 16,
          "maximum": 30,
          "step": 1,
          "value": 24,
          "columnSpan": 4
        }
      ]
    },
    {
      "title": "LUFTSTROM",
      "controls": [
        {
          "type": "picker",
          "label": "LÜFTERSTUFE",
          "command": "fanSpeed",
          "options": [
            "Auto",
            "Low",
            "Medium",
            "High",
            "Turbo"
          ],
          "columnSpan": 2
        },
        {
          "type": "picker",
          "label": "VERTIKALES SCHWENKEN",
          "command": "swingVertical",
          "options": [
            "Off",
            "Auto",
            "Up",
            "Middle",
            "Down"
          ],
          "columnSpan": 2
        },
        {
          "type": "picker",
          "label": "HORIZONTALES SCHWENKEN",
          "command": "swingHorizontal",
          "options": [
            "Off",
            "Auto",
            "Left",
            "Middle",
            "Right"
          ],
          "columnSpan": 4
        }
      ]
    },
    {
      "title": "KOMFORT",
      "controls": [
        {
          "type": "toggle",
          "label": "TURBO",
          "command": "turbo",
          "icon": "⚡"
        },
        {
          "type": "toggle",
          "label": "LEISE",
          "command": "quiet",
          "icon": "◔"
        },
        {
          "type": "toggle",
          "label": "ECO",
          "command": "economy",
          "icon": "♧"
        },
        {
          "type": "toggle",
          "label": "SCHLAF",
          "command": "sleep",
          "icon": "☾"
        },
        {
          "type": "toggle",
          "label": "ANZEIGE",
          "command": "display",
          "icon": "☼",
          "columnSpan": 2
        },
        {
          "type": "toggle",
          "label": "GESUNDHEIT",
          "command": "health",
          "icon": "✦",
          "columnSpan": 2
        }
      ]
    }
  ]
}
