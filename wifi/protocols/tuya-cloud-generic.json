{
  "schemaVersion": 1,
  "id": "tuya-cloud-generic",
  "version": 1,
  "minimumRuntimeVersion": 1,
  "status": "experimental",
  "deviceTypes": ["AirConditioner", "Television"],
  "requiredPrimitives": ["https", "json", "template", "hmac-sha256"],
  "discovery": [],
  "operations": {
    "getState": {
      "transport": "https",
      "method": "GET",
      "path": "{{getStateUrl}}",
      "headers": { "Authorization": "@secret:authorization" },
      "stateMap": {
        "power": "json:result.power",
        "targetTemperature": "json:result.targetTemperature",
        "currentTemperature": "json:result.currentTemperature",
        "mode": "json:result.mode",
        "fanSpeed": "json:result.fanSpeed"
      }
    },
    "setState": {
      "transport": "https",
      "method": "POST",
      "path": "{{setStateUrl}}",
      "headers": { "Authorization": "@secret:authorization" },
      "request": "{{tuyaCommandJson}}"
    }
  }
}
