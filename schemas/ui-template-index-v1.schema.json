{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sicsalad/HomeController-DeviceDB/schemas/ui-template-index-v1.schema.json",
  "title": "HomeController Device UI template index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templates"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "default": "stable" }
        }
      }
    }
  }
}
