{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sicsalad/HomeController-DeviceDB/schemas/protocol-v1.schema.json",
  "title": "HomeController reusable protocol metadata v1",
  "type": "object",
  "required": ["schemaVersion", "id", "transport", "controlModel"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "transport": { "type": "string" },
    "controlModel": { "type": "string" },
    "carrierFrequencyHz": { "type": "integer", "minimum": 1 },
    "runtimeEncoder": { "type": "string" },
    "stateBytes": { "type": "integer", "minimum": 1 },
    "variants": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
