{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sicsalad/HomeController-DeviceDB/schemas/device-v1.schema.json",
  "title": "HomeController DeviceDB device v1",
  "type": "object",
  "required": ["schemaVersion", "deviceType", "manufacturer", "model", "controlMethods"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deviceType": { "type": "string" },
    "manufacturer": { "type": "string" },
    "model": { "type": "string" },
    "remoteModel": { "type": ["string", "null"] },
    "verification": { "type": "string" },
    "controlMethods": { "type": "array", "minItems": 1 },
    "sources": { "type": "array" }
  }
}
