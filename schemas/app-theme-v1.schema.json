{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sicsalad/HomeController-DeviceDB/schemas/app-theme-v1.schema.json",
  "title": "HomeController application theme v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "mode", "minimumRuntimeVersion", "colors"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["light", "dark"] },
    "minimumRuntimeVersion": { "type": "integer", "minimum": 1 },
    "colors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/color" },
      "properties": {
        "Primary": { "$ref": "#/$defs/color" }, "PrimaryDark": { "$ref": "#/$defs/color" }, "PrimaryLight": { "$ref": "#/$defs/color" }, "OnPrimary": { "$ref": "#/$defs/color" },
        "Secondary": { "$ref": "#/$defs/color" }, "OnSecondary": { "$ref": "#/$defs/color" }, "Tertiary": { "$ref": "#/$defs/color" },
        "White": { "$ref": "#/$defs/color" }, "Black": { "$ref": "#/$defs/color" },
        "Gray100": { "$ref": "#/$defs/color" }, "Gray200": { "$ref": "#/$defs/color" }, "Gray300": { "$ref": "#/$defs/color" }, "Gray400": { "$ref": "#/$defs/color" }, "Gray500": { "$ref": "#/$defs/color" }, "Gray600": { "$ref": "#/$defs/color" }, "Gray900": { "$ref": "#/$defs/color" }, "Gray950": { "$ref": "#/$defs/color" },
        "PageBackground": { "$ref": "#/$defs/color" }, "Surface": { "$ref": "#/$defs/color" }, "SurfaceVariant": { "$ref": "#/$defs/color" },
        "TextPrimary": { "$ref": "#/$defs/color" }, "TextSecondary": { "$ref": "#/$defs/color" }, "TextMuted": { "$ref": "#/$defs/color" },
        "Accent": { "$ref": "#/$defs/color" }, "OnAccent": { "$ref": "#/$defs/color" },
        "NavigationBackground": { "$ref": "#/$defs/color" }, "NavigationText": { "$ref": "#/$defs/color" },
        "CardBackground": { "$ref": "#/$defs/color" }, "CardBorder": { "$ref": "#/$defs/color" },
        "InputBackground": { "$ref": "#/$defs/color" }, "InputText": { "$ref": "#/$defs/color" }, "PlaceholderText": { "$ref": "#/$defs/color" },
        "ButtonBackground": { "$ref": "#/$defs/color" }, "ButtonText": { "$ref": "#/$defs/color" },
        "SecondaryButtonBackground": { "$ref": "#/$defs/color" }, "SecondaryButtonText": { "$ref": "#/$defs/color" },
        "DisabledBackground": { "$ref": "#/$defs/color" }, "DisabledText": { "$ref": "#/$defs/color" }, "Separator": { "$ref": "#/$defs/color" },
        "Danger": { "$ref": "#/$defs/color" }, "OnDanger": { "$ref": "#/$defs/color" }, "Success": { "$ref": "#/$defs/color" }, "OnSuccess": { "$ref": "#/$defs/color" }
      }
    }
  },
  "$defs": { "color": { "type": "string", "pattern": "^#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" } }
}
