{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sicsalad/HomeController-DeviceDB/schemas/device-types-v1.schema.json",
  "title": "HomeController device type catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deviceTypes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "deviceTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "connections", "defaultUiTemplates"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "default": "🎛️" },
          "connections": { "type": "array", "items": { "enum": ["infrared", "wifi", "bluetooth"] }, "uniqueItems": true },
          "databaseTypeNames": { "type": "array", "items": { "type": "string" }, "default": [] },
          "sourcePathHints": { "type": "array", "items": { "type": "string" }, "default": [] },
          "defaultUiTemplates": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
          "setupHandler": { "type": "string", "default": "" }
        }
      }
    }
  }
}
