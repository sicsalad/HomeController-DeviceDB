{
  "$schema": "../../schemas/ble-profile-v1.schema.json",
  "schemaVersion": 1,
  "id": "qingping-cgp1w",
  "version": 1,
  "minimumRuntimeVersion": 1,
  "status": "experimental",
  "protocol": "Qingping FDCD weather-station service data",
  "match": { "serviceUuids": ["FDCD"], "serviceDataUuids": ["FDCD"] },
  "source": { "name": "Qingping CGP1W protocol facts documented by Theengs Decoder", "url": "https://decoder.theengs.io/devices/CGP1W.html", "license": "Protocol facts independently re-expressed in HomeController DeviceDB; Theengs Decoder implementation is GPL-3.0.", "notes": "Weather Station fixed FDCD layout. Battery byte uses the lower seven bits." },
  "fields": [
    { "code": "temperature", "name": "Temperature", "unit": "°C", "input": { "kind": "serviceData", "serviceUuid": "FDCD" }, "decode": { "type": "int16le", "offset": 10, "scale": 0.1 } },
    { "code": "humidity", "name": "Humidity", "unit": "%", "input": { "kind": "serviceData", "serviceUuid": "FDCD" }, "decode": { "type": "int16le", "offset": 12, "scale": 0.1, "minimum": 0, "maximum": 100 } },
    { "code": "pressure", "name": "Pressure", "unit": "hPa", "input": { "kind": "serviceData", "serviceUuid": "FDCD" }, "decode": { "type": "int16le", "offset": 16, "scale": 0.1 } },
    { "code": "battery", "name": "Battery", "unit": "%", "input": { "kind": "serviceData", "serviceUuid": "FDCD" }, "decode": { "type": "uint8", "offset": 20, "mask": 127, "minimum": 0, "maximum": 100 } }
  ]
}
