{
  "$schema": "../../schemas/ble-profile-v1.schema.json",
  "schemaVersion": 1,
  "id": "april-brother-abn03",
  "version": 1,
  "minimumRuntimeVersion": 1,
  "status": "experimental",
  "protocol": "BLE service data",
  "match": { "serviceDataPrefixes": ["AB03"] },
  "source": { "name": "Theengs Decoder ABN03 protocol facts", "url": "https://decoder.theengs.io/devices/ABN03.html", "license": "Protocol facts independently re-expressed in HomeController DeviceDB; Theengs Decoder implementation is GPL-3.0." },
  "fields": [
    { "code": "battery", "name": "Battery", "unit": "%", "input": { "kind": "serviceData" }, "decode": { "type": "uint8", "offset": 8 } },
    { "code": "temperature", "name": "Temperature", "unit": "°C", "input": { "kind": "serviceData" }, "decode": { "type": "int16le", "offset": 9, "scale": 0.125 } },
    { "code": "humidity", "name": "Humidity", "unit": "%", "input": { "kind": "serviceData" }, "decode": { "type": "uint16le", "offset": 11, "scale": 0.5 } },
    { "code": "illuminance", "name": "Illuminance", "unit": "lx", "input": { "kind": "serviceData" }, "decode": { "type": "uint16le", "offset": 13 } }
  ]
}
