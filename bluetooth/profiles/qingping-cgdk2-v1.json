{
  "$schema": "../../schemas/ble-profile-v1.schema.json",
  "schemaVersion": 1,
  "id": "qingping-cgdk2",
  "version": 1,
  "minimumRuntimeVersion": 1,
  "status": "experimental",
  "protocol": "Qingping FDCD service-data advertisement",
  "match": { "serviceUuids": ["FDCD"], "serviceDataUuids": ["FDCD"], "namePatterns": ["^CGDK.*"] },
  "source": { "name": "Qingping CGDK2 protocol facts documented by Theengs Decoder", "url": "https://decoder.theengs.io/devices/CGDK2.html", "license": "Protocol facts independently re-expressed in HomeController DeviceDB; Theengs Decoder implementation is GPL-3.0.", "notes": "Stock TH Lite FDCD layout; ATC/PVVX variants use the reusable 181A family." },
  "fields": [
    { "code": "temperature", "name": "Temperature", "unit": "°C", "input": { "kind": "serviceData", "serviceUuid": "FDCD" }, "decode": { "type": "int16le", "offset": 10, "scale": 0.1 } },
    { "code": "humidity", "name": "Humidity", "unit": "%", "input": { "kind": "serviceData", "serviceUuid": "FDCD" }, "decode": { "type": "int16le", "offset": 12, "scale": 0.1, "minimum": 0, "maximum": 100 } },
    { "code": "battery", "name": "Battery", "unit": "%", "input": { "kind": "serviceData", "serviceUuid": "FDCD" }, "decode": { "type": "uint8", "offset": 16, "minimum": 0, "maximum": 100 } }
  ]
}
